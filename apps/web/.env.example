# Public WebSocket of the standalone node (infra/standalone.cfg). Default: ws://localhost:6006.
# A site served over https can only use a wss:// URL (browsers block ws:// as mixed content).
NUXT_PUBLIC_LOCAL_NODE_URL=ws://localhost:6006
# The dev faucet that funds fresh accounts on the local node (started by `pnpm demo`).
NUXT_PUBLIC_LOCAL_FAUCET_URL=http://localhost:3005/accounts
